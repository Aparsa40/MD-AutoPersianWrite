{
  "name": "md-autopersianwrite",
  "description": "Persian Markdown Editor",
  "author": "Aparsa40",
  "private": true,
  "version": "2.6.0",
  "main": "electron/main.mjs",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "electron": "electron .",
    "electron:build": "npm run build:electron && electron-builder --win",
    "build:electron": "set ELECTRON_BUILD=1&& tsc && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\""
  },
  "dependencies": {
    "mermaid": "^10.9.8",
    "prismjs": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.0",
    "rehype-prism-plus": "^2.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.19",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.5.26",
    "prettier": "^3.2.5",
    "tailwindcss": "^3.4.3",
    "typescript": "5.5.4",
    "vite": "^8.2.1",
    "vitest": "^5.0.1"
  },

  "build": {
  "appId": "com.autopersianwrite.app",
  "productName": "MD-AutoPersianWrite",
  "icon": "build/icon.ico",
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
     ]
  }
}
